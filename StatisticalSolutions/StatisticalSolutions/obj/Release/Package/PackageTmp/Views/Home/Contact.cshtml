@{
    ViewBag.Title = "Contact";
}



<div id="container">


<div style="display:inline-block;" >
    <h3>Contact Us via email</h3>
<form class="form-inline" role="form">
    <div class="form-group">
        <label class="text-info">Name</label>
        <input type="text" class="form-control" placeholder="Name"  style="width:300px;margin-left:15px;" >
    </div>
    <p></p>
    <div class="form-group">
        <label class="text-info">Email</label>
        <input type="email" class="form-control" placeholder="Email"  style="width:300px;margin-left:15px;" >
    </div>
     <p></p>
    <div class="form-group">
        <label class="text-info">Subject</label>
        <input type="email" class="form-control" placeholder="Subject" style="width:300px;padding-left:2px;" ">
    </div>
     <p></p>
    <div class="form-group">
        <label class="text-info">Text</label><br/>
        <textarea class="form-control" cols="20" rows="2" style="width: 400px; height: 200px; max-height: 300px; max-width: 500px"></textarea>
    </div>
      <p></p>
    <button type="submit" class="btn btn-success btn-lg">Send</button>
</form>
</div>

<aside style="display:inline-block" >
    <h3>Contact Us Directly by:</h3>
    <p>
        We are always happy to hear from you
    </p>
