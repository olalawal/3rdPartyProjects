
  @{
        Layout = null;
         ViewBag.Title="Statistical solutions Error";
    }
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">

<html xmlns="http://www.w3.org/1999/xhtml">
    <head>
      <title>@ViewBag.Title    </title>      
    </head>
<body>
    @{
    <!--<div style="color:Red;font-size:large;font-weight:bold;">Error occured during this operation.</div>-->
    <div id="themeroller" style="word-wrap:break-word;text-align:center;min-height:450px; padding-top:50px;"> 
        
       <div style="display:inline-block;width:100px;text-align:center;vertical-align:top;">
        <img style="padding-right:25px;padding-bottom:50px;width:100%;float:right" src="~/Images/Error.png"/></div>
        <div id="StatisticalError" style="display:inline-block;width:600px;text-align:justify">
            <div style="color:red;font-weight:bold;font-size:25px;text-align:center;width:600px;">Looks like statistical solutions is experiencing an error. Please try it later.</div><br />
            
            <div style="display:inline-block;width:25%;padding-left:;vertical-align:top;">
                <h3>Error Message :</h3></div>
            <div style="display:inline-block;width:74%;"><h3>@Session["StatisticalError"].ToString()</h3></div>
            <br />
            <a href='@Url.Action("Index","Home")' class='button medium green'>Back to Home Page</a>
            
        </div>
       

        </div>
    }
</body>
</html>
