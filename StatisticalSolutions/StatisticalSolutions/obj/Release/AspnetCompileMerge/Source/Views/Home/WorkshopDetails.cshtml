@using StatisticalSolutions.Models;
@model seminar
@{
    ViewBag.Title = "WorkshopDetails";
}
<div class="container focus">
    <h4>
        <strong>
            @*<a  name="Basics" id="Basics"></a>*@
            @Html.Raw(Model.TitleHtml)
        </strong>
    </h4>
    <br />

</div>


<div class='container'>
    <section class='light-gray'>

        <div>
            @Html.Raw(Model.EventDetailsHtml)
        </div>
        <p>
            Available dates : <b>
                @if (Model.StartDate != null && Model.StartDate != default(DateTime))
                {
                    @Html.Raw(Model.StartDate.ToShortDateString())
                }
            </b>
        </p>
        <div>

            @if (Model.StartDate != null && Model.StartDate != default(DateTime))
            {
                registration reg = new registration();
                reg.seminar_id = Model.seminar_id;
                <a href='@Url.Action("Register", "Home", reg)' class='button medium green'>Register Now</a>
            }
        </div>

    </section>
</div>
