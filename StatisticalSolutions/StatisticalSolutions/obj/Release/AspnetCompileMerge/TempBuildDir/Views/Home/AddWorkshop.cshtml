@model StatisticalSolutions.Models.seminar
@{
    ViewBag.Title = "AddWorkshop";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    HtmlHelper.ClientValidationEnabled = true;
}

<meta http-equiv="Content-Type" content="text/html;charset=utf-8" />

<div class='container'>
    <div class='sixteen columns form'>
        <h3>Enter your Seminar info</h3>
        @*<p>Select the workshop you wish to register , it will be pre-selected for you if you already were re-directed</p>*@
        @using (Html.BeginForm("AddWorkshop", "Home", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div id="divworkshop">
                <fieldset>
                    <ol>

                        <li>
                            <div>
                                <label>Title</label>
                                @Html.ValidationMessageFor(model => model.TitleHtml)
                                @Html.TextBoxFor(model => model.TitleHtml, new { @tabindex = "1", @placeholder = "Title", @class = "form-control" })
                            </div>
                        </li>
                        <li>

                            <label>Description</label>
                            @Html.ValidationMessageFor(model => model.Description)
                            @Html.TextBoxFor(model => model.Description, new { @tabindex = "2", @placeholder = "Description", @class = "form-control" })

                        </li>                      
                        <li>
                            <label>Start Date</label>
                            @Html.ValidationMessageFor(model => model.StartDate)
                            @Html.TextBoxFor(model => model.StartDate, "{0:MM/dd/yyyy}", new { @tabindex = "3", @placeholder = "MM/DD/YYYY", @class = "form-control calendar" })

                        </li>
                        <li>
                            <label>End Date</label>
                            @Html.ValidationMessageFor(model => model.Enddate)
                            @Html.TextBoxFor(model => model.Enddate, "{0:MM/dd/yyyy}", new { @tabindex = "4", @placeholder = "MM/DD/YYYY", @class = "form-control calendar" })

                        </li>
                        <li>
                            <label>Address Line 1</label>
                            @Html.ValidationMessageFor(model => model.Address1)
                            @Html.TextBoxFor(model => model.Address1, new { @tabindex = "5", @placeholder = "Address line l", @class = "form-control" })

                        </li>
                        <li>
                            <label>Address Line 2</label>
                            @Html.TextBoxFor(model => model.Address2, new { @tabindex = "6", @placeholder = "Address line 2", @class = "form-control" })

                        </li>
                        <li>
                            <label>City</label>
                            @Html.ValidationMessageFor(model => model.City)
                            @Html.TextBoxFor(model => model.City, new { @tabindex = "7", @placeholder = "City", @class = "form-control" })

                        </li>
                        <li>
                            <label>State/Province</label>
                            @Html.ValidationMessageFor(model => model.StateProvince)
                            @Html.TextBoxFor(model => model.StateProvince, new { @tabindex = "8", @placeholder = "State/Province", @class = "form-control" })

                        </li>
                        <li>
                            <label>Country</label>
                            @Html.ValidationMessageFor(model => model.Country)
                            @Html.DropDownListFor(model => model.Country, new SelectList(@ViewBag.Countries, "Country", "Country"), "--Select Country--", new { @tabindex = "9" })
                        </li>

                        <li>
                            <label>Email Address</label>
                            @Html.ValidationMessageFor(model => model.Email)
                            @Html.TextBoxFor(model => model.Email, new { @tabindex = "10", @placeholder = "Email address", @class = "form-control" })

                        </li>

                        <li>
                            <label>Phone Number</label>
                            @Html.ValidationMessageFor(model => model.Phone)
                            @Html.TextBoxFor(model => model.Phone, new { @tabindex = "11", @placeholder = "Phone number", @class = "form-control" })

                        </li>
                        <li>
                            <label>Fax Number</label>
                            @Html.ValidationMessageFor(model => model.Fax)
                            @Html.TextBoxFor(model => model.Phone, new { @tabindex = "12", @placeholder = "Fax number", @class = "form-control" })

                        </li>
                        <li>
                            <label>Contact Email</label>
                            @Html.ValidationMessageFor(model => model.ContactEmail)
                            @Html.TextBoxFor(model => model.ContactEmail, new { @tabindex = "13", @placeholder = "Contact Email", @class = "form-control" })

                        </li>
                        <li>
                            <label>Contact Phone</label>
                            @Html.ValidationMessageFor(model => model.ContactPhone)
                            @Html.TextBoxFor(model => model.Phone, new { @tabindex = "14", @placeholder = "Contact Phone", @class = "form-control" })

                        </li>
                        <li>
                            <label>Contact Website</label>
                            @Html.ValidationMessageFor(model => model.ContactWebsite)
                            @Html.TextBoxFor(model => model.ContactWebsite, new { @tabindex = "15", @placeholder = "Contact Website", @class = "form-control" })

                        </li>
                        <li>
                            <span class="checkbox">

                                @Html.CheckBoxFor(model => model.IsActive, new { @tabindex = "16", @class = "form-control" })
                            </span>
                            <span class="checkbox-label">
                                <label>Active</label>
                                @Html.ValidationMessageFor(model => model.IsActive)
                            </span>
                        </li>
                        <li>                            
                            <label>Event Details Html</label>
                            @Html.ValidationMessageFor(model => model.EventDetailsHtml)
                            @Html.TextAreaFor(model => model.EventDetailsHtml, new { @tabindex = "17", @row = "15", @cols = "50", @class = "form-control html-editor", @style = "width:100%;height:250px;overflow:auto;" })

                        </li>
                        <li>
                         
                            <input type="submit" tabindex="18" value="Submit" class="button medium green" />
                        </li>
                    </ol>
                </fieldset>

            </div>

        }
    </div>
</div>

