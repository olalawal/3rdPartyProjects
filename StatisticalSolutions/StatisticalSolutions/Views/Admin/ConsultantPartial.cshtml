@using StatisticalSolutions.Models
@model instructor
<tr>
    <td>
        @{string path = "http://statisticalsolutions.azurewebsites.net/" + Model.ImagePath;}
        <img src="@path" height="60" width="60" class="img-circle" />

    </td>
    <td>
        <a href='@Url.Action("AssignedSeminars", "Admin", new { id = Model.instructor_id })'>@Model.Name</a>

    </td>
    <td>
        @Html.DisplayFor(m => m.Email)

    </td>
    <td>
        @Html.DisplayFor(m => m.Phone)
    </td>

    <td>
        @if (Model.assignedseminars != null)
        {
            foreach (seminar sem in Model.assignedseminars)
            {
                <div>
                    @Html.DisplayFor(m=>sem.TitleHtml)                    
                </div>
            }
        }

    </td>
    <td>
        @Html.ActionLink("Edit", "EditConsultant", new { id = Model.instructor_id }) |
        @Html.ActionLink("Delete", "DeleteConsultant", new { id = Model.instructor_id })
</tr>
