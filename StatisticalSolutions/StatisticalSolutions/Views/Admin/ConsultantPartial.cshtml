@model StatisticalSolutions.ViewModels.SeminarInstructorModel
<tr>
    <td>
        @{string path = ViewBag.VirtualPath + Model.Instructor.ImagePath;}
        <img src="@path" height="60" width="60" class="img-circle" />
        @*@Html.DisplayFor(m => m.Name)*@
    </td>
    <td>
        @Html.DisplayFor(m => m.Instructor.Name)
    </td>
    <td>
        @Html.DisplayFor(m => m.Instructor.Email)

    </td>
    <td>
        @Html.DisplayFor(m => m.Instructor.Phone)
    </td>
    <td>
        @Html.DisplayFor(model => model.seminar.TitleHtml)
    </td>

    <td>
        @Html.ActionLink("Edit", "EditConsultant", new { id = Model.Instructor.instructor_id }) |
        @Html.ActionLink("Delete", "DeleteConsultant", new { id = Model.Instructor.instructor_id })
</tr>
