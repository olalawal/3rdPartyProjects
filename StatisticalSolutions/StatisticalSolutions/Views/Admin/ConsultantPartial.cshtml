@model StatisticalSolutions.Models.instructor
<tr>
    <td>
        @{string path = ViewBag.VirtualPath + Model.ImagePath;}
        <img src="@path" height="60" width="60" class="img-circle" />
        @*@Html.DisplayFor(m => m.Name)*@
    </td>
    <td>
        @Html.DisplayFor(m => m.Name)
    </td>
    <td>
        @Html.DisplayFor(m => m.Email)

    </td>
    <td>
        @Html.DisplayFor(m => m.Phone)
    </td>
    <td>
        @Html.CheckBoxFor(model => model.IsActive)
    </td>

    <td>
        @Html.ActionLink("Edit", "EditConsultant", new { id = Model.instructor_id }) |
        @Html.ActionLink("Delete", "DeleteConsultant", new { id = Model.instructor_id })
</tr>
