@using StatisticalSolutions.Models
@model List<instructor>
@{
    ViewBag.Title = "ConsultantList";
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />

<div class='container focus'>
    <div class="breadcrumb" id="divPageTitle_Add">
        <a tabindex="1" href="@Url.Action("Admin", "Account")">Dashboard</a>
        <span class="active"> - Consultants List</span>
    </div>


    <div class='twelve form'>
        <section>

            <div class="content">
                @if (Model.Count != 0)
                {
                    <table class="table table-bordered table-striped" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:7%;">Photo</th>
                                <th style="width:25%;">Consultant</th>
                                <th style="width:28%;">Email</th>
                                <th style="width:20%;">Phone</th>
                                <th style="width:10%;">Is Active</th>
                                <th style="width:10%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (instructor ins in Model)
                            {
                                @Html.Partial("ConsultantPartial", ins)
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>no consultant records found</p>
                }

            </div>

        </section>
    </div>
</div>
