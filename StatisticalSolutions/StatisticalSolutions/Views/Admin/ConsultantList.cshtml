@using StatisticalSolutions.Models
@model List<instructor>
@{
    ViewBag.Title = "ConsultantList";
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />

<div class='container focus'>
    <div class="breadcrumb" id="divPageTitle_Add">
        <a tabindex="1" href="@Url.Action("Admin", "Admin")">Dashboard</a>
        <span class="active"> - Consultants List</span>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.InativeConsultants))
    {
        <div class='sixteen form'>

            <div class="checkbox ">
                @using (Html.BeginForm("InactiveConsultants", "Admin", FormMethod.Post, new { @style = "margin:0;margin-left:20px;" }))
                {
                    <input type="checkbox" name="IsActive" value="false" onclick=" this.form.submit();" />
                    <span>Inactive Consultants</span>
                }
            </div>

        </div>
    }
    <div class='sixteen form'>
        <section>

            <div class="content">
                @if (Model.Count != 0)
                {
                    <table class="table table-bordered table-striped" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:7%;">Photo</th>
                                <th style="width:20%;">Consultant</th>
                                <th style="width:25%;">Email</th>
                                <th style="width:13%;">Phone</th>
                                <th style="width:25%;">Assigned Seminars</th>
                                <th style="width:10%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (instructor ins in Model)
                            {
                                @Html.Partial("ConsultantPartial", ins)
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>no consultant records found</p>
                }

            </div>

        </section>
    </div>
</div>
