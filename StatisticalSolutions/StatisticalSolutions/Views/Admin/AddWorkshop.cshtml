@model StatisticalSolutions.Models.WorkshopViewModel
@{
    ViewBag.Title = "AddWorkshop";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    HtmlHelper.ClientValidationEnabled = true;
   
}

<meta http-equiv="Content-Type" content="text/html;charset=utf-8" />

<div class='container focus'>
    <div class="breadcrumb" id="divPageTitle_Add">
        <a tabindex="21" href="@Url.Action("Admin", "Admin")">Dashboard</a>
        <span class="active"> - Add Workshop</span>
    </div>
    <div class='sixteen columns form'>
        <h3>Enter your Seminar info</h3>
        @*<p>Select the workshop you wish to register , it will be pre-selected for you if you already were re-directed</p>*@
        @using (Html.BeginForm("AddWorkshop", "Admin", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div id="divworkshop">
                <fieldset>
                    <ol>

                        <li>
                            <div>                              
                                <label>Title</label>
                                @Html.ValidationMessageFor(model => model.TitleHtml)
                                @Html.TextBoxFor(model => model.TitleHtml, new { @tabindex = "1", @placeholder = "Title", @class = "form-control" })
                            </div>
                        </li>
                        <li>
                            <label>Consultant</label>                            
                            @Html.DropDownListFor(model => model.instructor_id, new SelectList(Model.Instructors, "instructor_id", "Name"), "-- Select Consultant--", new { @tabindex = "2" })
                        </li>
                        <li>
                            <label>Description</label>
                            @Html.ValidationMessageFor(model => model.Description)
                            @Html.TextBoxFor(model => model.Description, new { @tabindex = "3", @placeholder = "Description", @class = "form-control" })

                        </li>
                     
                        <li>
                            <div class="mid-left">
                                <label class="mid-left">Start Date</label>
                                @Html.ValidationMessageFor(model => model.StartDate)
                                @Html.TextBoxFor(model => model.StartDate, "{0:MM/dd/yyyy}", new {id="txtStartDate", @tabindex = "4", @autocomplete="off", @placeholder = "MM/DD/YYYY", @class = "form-control calendar mid-size" })
                            </div>
                            <div class="mid-right">
                                <label class="mid-left">Start Time</label>
                                @Html.ValidationMessageFor(model => model.Starttime)
                                @Html.TextBoxFor(model => model.Starttime, new { @tabindex = "5", @placeholder = "Start Time", @class = "form-control" })
                            </div>
                        </li>
                        <li>
                            <div class="mid-left">
                                <label class="mid-left">End Date</label>
                                @Html.ValidationMessageFor(model => model.Enddate)
                                @Html.TextBoxFor(model => model.Enddate, "{0:MM/dd/yyyy}", new { id = "txtEndDate", @tabindex = "6", @autocomplete = "off", @placeholder = "MM/DD/YYYY", @class = "form-control calendar" })
                            </div>

                            <div class="mid-right">
                                <label class="mid-left">End Time</label>
                                @Html.ValidationMessageFor(model => model.Endtime)
                                @Html.TextBoxFor(model => model.Endtime, new { @tabindex = "7", @placeholder = "End Time", @class = "form-control mid-size" })
                            </div>
                        </li>
                        <li>
                            <label>Address Line 1</label>
                            @Html.ValidationMessageFor(model => model.Address1)
                            @Html.TextBoxFor(model => model.Address1, new { @tabindex = "8", @placeholder = "Address line l", @class = "form-control" })

                        </li>
                        <li>
                            <label>Address Line 2</label>
                            @Html.TextBoxFor(model => model.Address2, new { @tabindex = "9", @placeholder = "Address line 2", @class = "form-control" })

                        </li>
                        <li>
                            <label>City</label>   
                            @Html.ValidationMessageFor(model => model.City)                     
                            @Html.TextBoxFor(model => model.City, new { @tabindex = "10", @placeholder = "City", @class = "form-control" })

                        </li>
                        <li>
                            <label>State/Province</label>
                            @Html.ValidationMessageFor(model => model.StateProvince)
                            @Html.TextBoxFor(model => model.StateProvince, new { @tabindex = "11", @placeholder = "State/Province", @class = "form-control" })

                        </li>
                        <li>
                            <label>Country</label>
                            @Html.ValidationMessageFor(model => model.Country)
                            @Html.DropDownListFor(model => model.Country, new SelectList(Model.Countries, "Country", "Country"), "-- Select Country --", new { @tabindex = "12" })
                        </li>

                        <li>
                            <label>Email Address</label>
                            @Html.ValidationMessageFor(model => model.Email)
                            @Html.TextBoxFor(model => model.Email, new { @tabindex = "13", @placeholder = "Email address", @class = "form-control" })

                        </li>

                        <li>
                            <label>Phone Number</label> 
                            @Html.ValidationMessageFor(model => model.Phone)                        
                            @Html.TextBoxFor(model => model.Phone, new { @tabindex = "14", @placeholder = "Phone number", @class = "form-control" })

                        </li>
                        <li>
                            <label>Fax Number</label>                   
                            @Html.TextBoxFor(model => model.Fax, new { @tabindex = "15", @placeholder = "Fax number", @class = "form-control" })

                        </li>
                        <li>
                            <label>Contact Email</label> 
                            @Html.ValidationMessageFor(model => model.ContactEmail)                          
                            @Html.TextBoxFor(model => model.ContactEmail, new { @tabindex = "16", @placeholder = "Contact Email", @class = "form-control" })

                        </li>
                        <li>
                            <label>Contact Phone</label>                            
                            @Html.TextBoxFor(model => model.ContactPhone, new { @tabindex = "17", @placeholder = "Contact Phone", @class = "form-control" })

                        </li>
                        <li>
                            <label>Contact Website</label>                       
                            @Html.TextBoxFor(model => model.ContactWebsite, new { @tabindex = "18", @placeholder = "Contact Website", @class = "form-control" })

                        </li>                    
                        <li>
                            <label>Event Details Html</label>  
                            @Html.ValidationMessageFor(model => model.EventDetailsHtml)                          
                            @Html.TextAreaFor(model => model.EventDetailsHtml, new { id = "txtEventDetailsHtml", @tabindex = "19", @row = "15", @cols = "50", @class = "form-control html-editor required jqte-validation", @style = "width:100%;height:250px;overflow:auto;" })

                        </li>
                        <li>

                            <input type="submit" id="btnSubmit" tabindex="20" value="Submit" class="button medium green" />
                        </li>
                    </ol>
                </fieldset>

            </div>

        }
    </div>
</div>

@{
    if (Model.StartDate == default(DateTime))
    {
        <script>
            $('#txtStartDate').value = "";
        </script>
    }
    if (Model.Enddate == default(DateTime))
    {
        <script>
            $('#txtEndDate').value = "";
        </script>
    }
}

<script type="text/javascript" >
   
   
    $.validator.setDefaults({
        ignore: []
    });

    var refValid = $("#txtEventDetailsHtml").validate({
            errorClass: 'maskError',
            errorPlacement: function (error, element) {
                var el = $(element).closest(".jqte");
                if (el.length == 1) {
                    error.insertBefore(el);
                } else {
                    error.insertBefore(element);
                }
            },
            highlight: function (element, errorClass, validClass) {
                $(element).addClass(errorClass).removeClass(validClass);

                var el = $(element).closest(".jqte");
                if (el.length == 1) {
                    el.addClass(errorClass);
                }
            },
            unhighlight: function (element, errorClass, validClass) {
                $(element).removeClass(errorClass).addClass(validClass);
                var el = $(element).closest(".jqte");
                if (el.length == 1) {
                    el.removeClass(errorClass);
                }
            },
            onkeyup: false
        });
 
        $("#txtEventDetailsHtml").closest(".jqte").find(".jqte_editor").blur(function () {
            if (!$.isEmptyObject(refValid.submitted)) {
                refValid.form();
            }
        });

    $(document).on("click", "#btnSubmit", function () {
        if (refValid.form()) {     
        }
      
    });
</script>

