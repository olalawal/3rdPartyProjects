@using StatisticalSolutions.Models
@model List<seminar>
@{
    ViewBag.Title = "WorkshopList";
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />

<div class='container focus'>
    <div class="breadcrumb" id="divPageTitle_Add">
        <a tabindex="1" href="@Url.Action("Admin", "Account")">Dashboard</a>
        <span class="active"> - Workshop List</span>
    </div>
   

    <div class='sixteen form'>
        <section>

            <div class="content">
                @if (Model.Count != 0)
                {
                    <table class="table table-bordered table-striped" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:30%;">Title</th>
                                <th style="width:20%;">Start Date</th>
                                <th style="width:20%;">End Date</th>
                                <th style="width:10%;">Start Time</th>
                                <th style="width:10%;">End Time</th>
                                <th style="width:10%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (seminar sem in Model)
                            {
                                @Html.Partial("WorkshopPartial", sem)
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>no workshop records found</p>
                }

            </div>

        </section>
    </div>
</div>








