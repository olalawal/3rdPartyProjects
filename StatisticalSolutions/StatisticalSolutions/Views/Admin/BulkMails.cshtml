@using System.Collections.Generic;
@using StatisticalSolutions.Models;
@using StatisticalSolutions.ViewModels;
@model  BulkMailModel
@{
    ViewBag.Title = "BulkMails";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />

<div class='container focus'>
    <div class="breadcrumb" id="divPageTitle_Add">
        <a tabindex="3" href="@Url.Action("Admin", "Account")">Dashboard</a>
        <span class="active"> - Bulk Mail</span>
    </div>



    @using (Html.BeginForm("BulkMailsFilter", "Admin", FormMethod.Post))
    {
        @Html.DropDownList("FilterText", new SelectList(@ViewBag.Filter), "--Select Filter--", new { @tabindex = "1", @placeholder = "Filter", @class = "filter-dropdown" })
        <input type="submit" value="Filter" class="medium green filter-button" />
        <br />
    }
    @using (Html.BeginForm())
    {
        <label>Workshops</label>
        @Html.DropDownListFor(model => model.Registration.seminar_id, new SelectList(@ViewBag.regseminars, "seminar_id", "TitleHtml", Model.Registration.seminar_id), "--Select Seminar--", new { @tabindex = "1", @placeholder = "Seminar", onchange = "return selectseminar(this.options[this.selectedIndex].value, this.selectedIndex)" })
    }


    @using (Html.BeginForm("BulkMails", "Admin", FormMethod.Post))
    {


        if (Model != null)
        {
            if (Model.Registration != null)
            {
                <div class="clear"></div>
                @Html.HiddenFor(model => model.Registration.seminar_id)
                <br />

            }
            if (Model.Students.Any())
            {
                <div style="color:red;"> @Model.Students.Count active registered students found for this seminar </div>
                <table class="table table-bordered table-striped" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width:30%;">Name</th>
                            <th style="width:40%;">Email</th>
                            <th style="width:30%;">Contact</th>
                            @*<th style="width:10%;">Active</th>*@
                        </tr>

                    </thead>
                    <tbody>
                        @foreach (student student in Model.Students)
                        {
                            @Html.Partial("BulkMailsPartial", student)
                        }

                    </tbody>
                </table>
                <input type="submit" tabindex="2" value="Send Mails" class="button medium green filter-button right-align" />
            }

        }


    }
</div>


<script type="text/javascript">

    function selectseminar( value, index)
    {
        if (index > 0)
        {
            document.location.href = '../Admin/BulkMailStudents/' + value;            
        }
    }
</script>

