@model StatisticalSolutions.ViewModels.SeminarInstructorModel
<tr>
    <td>
        @Html.DisplayFor(m => m.seminar.TitleHtml)
    </td>
    <td>
        @if(Model.Instructor !=null)
        {
            @Html.DisplayFor(m => m.Instructor.Name) 
        }
       
    </td>
    <td>
        @Model.seminar.StartDate.ToString("dddd, MMM dd, yyyy")

    </td>
    <td>
        @Model.seminar.Enddate.ToString("dddd, MMM dd, yyyy")
        </td>
    <td>
       @Html.DisplayFor(m => m.seminar.Starttime)
    </td>
    <td>
        @Html.DisplayFor(m => m.seminar.Endtime)
    </td>

    <td>
        @Html.ActionLink("Edit", "EditWorkshop", new { id = Model.seminar.seminar_id }) | 
        @Html.ActionLink("Delete", "DeleteWorkshop", new { id = Model.seminar.seminar_id })
</tr>
