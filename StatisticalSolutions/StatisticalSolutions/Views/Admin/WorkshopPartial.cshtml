@model StatisticalSolutions.Models.seminar
<tr>
    <td>
        @Html.DisplayFor(m => m.TitleHtml)
    </td>
    <td>
        @Model.StartDate.ToString("dddd, MMM dd, yyyy")

    </td>
    <td>
        @Model.Enddate.ToString("dddd, MMM dd, yyyy")
        </td>
    <td>
       @Html.DisplayFor(m => m.Starttime)
    </td>
    <td>
        @Html.DisplayFor(m => m.Endtime)
    </td>

    <td>
        @Html.ActionLink("Edit", "EditWorkshop", new { id = Model.seminar_id }) | 
        @Html.ActionLink("Delete", "DeleteWorkshop", new { id = Model.seminar_id })
</tr>
