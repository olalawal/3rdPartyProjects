@model StatisticalSolutions.Models.registration
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    HtmlHelper.ClientValidationEnabled = true;
}


<div class='container'>
    <div class='sixteen columns form'>    
        <h3>Enter your registration info</h3>
        <p>Select the workshop you wish to register , it will be pre-selected for you if you already were re-directed</p>
        @using (Html.BeginForm("RegisterWorkshop", "Home", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
       
    <div id="divregistration">
        <fieldset>
            <ol>
                <li>
                   
                    <label>WorkShop</label>
                    @Html.ValidationMessageFor(m => m.seminar_id)
                    @{
                        string seminatId=Convert.ToString(Model.seminar_id);
                    }
                    @Html.DropDownListFor(model => model.seminar_id, new SelectList(@ViewBag.Seminars, "seminar_id", "TitleHtml", seminatId), "--Select Seminar--", new {@placeholder="Seminar"})
                </li>
                <li>
                    <label>Select Start Date</label>
                    @Html.ValidationMessageFor(m => m.StartDate)
                    @Html.DropDownListFor(model => model.StartDate, new SelectList(@ViewBag.StartDates, "StartDate", "StartDate", Model.StartDate), "--Select Start Date--", new {@placeholder="Start Date"})
                </li>
                <li>
                    <div >
                        <label>Company</label>
                        @Html.TextBoxFor(model => model.client.Name, new { id = "txtCompany", @tabindex = "3", @placeholder = "Auto complete i.e as they type the company they get suggestions from client table", style = "width:100%;float:left", @class = "form-control" })
                    </div>
                </li>
                <li>
                 
                    <label>First Name</label>
                    @Html.ValidationMessageFor(model => model.student.FirstName)
                    @Html.TextBoxFor(model => model.student.FirstName, new { @placeholder = "Your First name", @class = "form-control" })
                   
                </li>
                <li>
                    <label>Last Name</label>
                    @Html.ValidationMessageFor(model => model.student.LastName)
                    @Html.TextBoxFor(model => model.student.LastName, new { @placeholder = "Your Last name", @class = "form-control" })

                </li>
                <li>
                    <label>Address Line 1</label>
                    @Html.ValidationMessageFor(model => model.student.Address1)
                    @Html.TextBoxFor(model => model.student.Address1, new { @placeholder = "Your address line l", @class = "form-control" })
                   
                </li>
                <li>
                    <label>Address Line 2</label>
                    @Html.TextBoxFor(model => model.student.Address2, new { @placeholder = "Your address line 2", @class = "form-control" })
               
                </li>
                <li>
                    <label>City</label>
                    @Html.ValidationMessageFor(model => model.student.City)
                    @Html.TextBoxFor(model => model.student.City, new { @placeholder = "Your city", @class = "form-control" })
                   
                </li>
                <li>
                    <label>State/Province</label>
                    @Html.ValidationMessageFor(model => model.student.StateProvince)
                    @Html.TextBoxFor(model => model.student.StateProvince, new { @placeholder = "Your state/Province", @class = "form-control" })
                  
                </li>
                <li>
                    <label>Country</label>
                    @Html.ValidationMessageFor(model => model.student.Country)
                    @Html.DropDownListFor(model=>model.student.Country,new SelectList(@ViewBag.Countries,"Country", "Country"), "--Select Country--")
                </li>

                <li>
                    <label>Email Address</label>
                    @Html.ValidationMessageFor(model => model.student.Email)
                    @Html.TextBoxFor(model => model.student.Email, new { @placeholder = "Your Email address", @class = "form-control" })
                   
                </li>
                <li>
                    <label>Bank Account #</label>
                    @Html.ValidationMessageFor(model => model.student.BankAccountNumber)
                    @Html.TextBoxFor(model => model.student.BankAccountNumber, new { @placeholder = "Your bank account number", @class = "form-control" })
                   
                </li>
                <li>
                    <label>Phone Number</label>
                    @Html.ValidationMessageFor(model => model.student.BankAccountNumber)
                    @Html.TextBoxFor(model => model.student.Phone, new { @placeholder = "Your phone number", @class = "form-control" })
                    
                </li>  
                <li>
                    @*<a href='@Url.Action("RegisterComplete", "Home")'  class='button medium green'>Submit</a>*@
                    <input type="submit" value="Submit" class="button medium green" />
                </li>
            </ol>
        </fieldset>

    </div>

        }
    </div>
</div>



<script type="text/javascript">
    $(function () {
        
        var companies = new Array;
        var availableCompanies = @Html.Raw(Json.Encode(ViewBag.Companies));
           for(var i =0; i<availableCompanies.length;i++)
            {
               companies[i] = availableCompanies[i];
           }         

        $("#txtCompany").autocomplete({
            source: companies
        });
    });
</script>