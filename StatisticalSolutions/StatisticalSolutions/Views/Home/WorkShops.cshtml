@using System.Collections.Generic;
@using StatisticalSolutions.Models;
@model List<seminar>
@{
    ViewBag.Title = "WorkShops";
}


<div class="container focus">
    <h4>Currently Available WorkShops</h4>

</div>


<div class='container twelve.columns'>

    @foreach (seminar s in Model)
    {
        <section class='gray'>
            <h4>
                <strong>
                    @*<a  name="Basics" id="Basics"></a>*@
                    @Html.Raw(s.TitleHtml);
                </strong>
            </h4>
            <br />
            <div>
                @Html.Raw(s.EventDetailsHtml)
            </div>
            <p>
                Available dates : <b>
                    @if (s.StartDate != null && s.StartDate != default(DateTime))
                    {
                        @Html.Raw(s.StartDate.ToShortDateString())
                    }
                </b>
            </p>
            <div>

                @if (s.StartDate != null && s.StartDate != default(DateTime))
                {
                    registration reg = new registration();
                    reg.seminar_id = s.seminar_id;
                    <a href='@Url.Action("Register", "Home", reg)' class='button medium green'>Register Now</a>
                }


            </div>
        </section>

    }


</div>