@using System.Collections.Generic;
@using StatisticalSolutions.Models;
@using StatisticalSolutions.ViewModels;
@{
    ViewBag.Title = "Consultants";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}
<meta http-equiv="Content-Type" content="text/html;charset=utf-8" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />

<div class="container focus">
    <h2>Our Consultants</h2>
</div>

<div class="clear"></div>

<div class='container focus'>
    @{List<instructor> Consultants = ViewBag.Consultants as List<instructor>;}
    @if (Consultants.Count > 0)
    {
        <div class="four columns">
            @foreach (instructor instructor in Consultants)
            {
                <ul>
                    <li>
                        @Html.ActionLink(instructor.Name, "Consultant", new { id = instructor.instructor_id })
                        <hr class="hr" />
                    </li>
                </ul>
               
            }

        </div>
        
        <div class='nine columns'>
            @{ instructor ins = ViewBag.Instructor; }
            @if (ins != null)
            {
                <div class='nine columns'> 
                    <div class="nine">
                        @{string path = ViewBag.VirtualPath + ins.ImagePath;}
                        <img src="@path" height="120" width="120" class="img-circle" />
                        &nbsp; &nbsp; &nbsp;
                        <strong>
                            @Html.Raw(ins.Name)
                        </strong>
                    </div> 
                    <div class="nine">
                       
                        <br />
                        @Html.Raw(ins.Description.Trim())
                    </div> 
                <hr />
                    <br />
                    @Html.Raw(ins.DetailsHtml)
                </div>

            }
            else
            {
                <div class='nine columns'>

                    <h2>Nothing beats personal contact with a great instructor!</h2>
                    <br />
                    <div>
                        When it comes to statistics, a top-notch instructor can make all the difference. At Statistical Horizons, we only recruit the best. All our instructors are recognized experts in their fields. Equally important, they have the talent and experience to make statistics interesting and understandable to researchers from a wide variety of backgrounds. Take one of our seminars and you’ll see what we mean.
                    </div>

                    @foreach (instructor instructor in Consultants)
                    {
                        @Html.Partial("_ConsultantDetailsPartial", instructor)
                    }
                </div>

            }

        </div>
        
        <div class='container six columns'>
            upcoming <br /><b>Seminars</b>
            <hr class="hr" />
            @{List<SeminarInstructorModel> sem_ins = ViewBag.Seminar_Instructor as List<SeminarInstructorModel>;}
            @foreach (SeminarInstructorModel sems in sem_ins)
            {

                @Html.Partial("_SeminarPartial", sems)

            }
        </div>
    }

</div>
