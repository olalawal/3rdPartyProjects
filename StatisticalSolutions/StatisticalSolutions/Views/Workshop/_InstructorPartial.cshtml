@model StatisticalSolutions.Models.instructor
         
<div class="two columns">
    @{
        string path = ViewBag.VirtualPath + "/"+ @Model.ImagePath;
    }
    <img src="@path" height="90" width="90" class="img-circle" />
</div>
<div class="three columns">
    <ul>
        <li>
            <a href='@Url.Action("Consultant", "Instructor", new { id = Model.instructor_id })' >@Model.Name</a>
           
        </li>

        <li>
          @Html.Raw(Model.Description.Substring(0,200).Trim())
        </li>

    </ul>
</div>
