@model StatisticalSolutions.Models.registration
@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    HtmlHelper.ClientValidationEnabled = true;
}


<div class='container'>
    <div class='sixteen columns form'>
        <h3>Enter your registration info</h3>
        <p>Select the workshop you wish to register , it will be pre-selected for you if you already were re-directed</p>
        @using (Html.BeginForm("Register", "Workshop", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

              @Html.Partial("_RegisterPartial", Model)

        }
    </div>
</div>



<script type="text/javascript">
    $(function () {

        var companies = new Array;
        var availableCompanies = @Html.Raw(Json.Encode(ViewBag.Companies));
        for(var i =0; i<availableCompanies.length;i++)
        {
            companies[i] = availableCompanies[i];
        }

        $("#txtCompany").autocomplete({
            source: companies
        });

         


