
@model StatisticalSolutions.Models.seminar
    
<div class='nine columns'>

    <div class='nine columns'>
        <div class="font-bold" style="text-align:center;">
            <strong>@Html.Raw(Model.TitleHtml)</strong>
        </div>
        <div style="text-align:center;">
            @if (Model.instructor != null)
            {
                <span> @Model.instructor.Name</span>
            }
        </div>
        <br />
        @Html.Raw(Model.EventDetailsHtml)
    </div>

</div>

<div class='container six columns'>

    <div class="six columns">
        Seminar <br />
        <b>Information</b>
        <hr class="hr" />
    </div>

    <div class="six columns">
        Available dates : <b>
            @if (Model.StartDate != null && Model.StartDate != default(DateTime))
            {
                if (Model.StartDate == Model.Enddate)
                {
                    @Model.StartDate.ToString("MMM, d")
                }
                else
                {
                    if (Model.StartDate.Month == Model.Enddate.Month)
                    {
                        <span>
                            @Model.StartDate.ToString("MMM, d")
                        </span>
                        <span> - </span>
                        <span>  @Model.Enddate.Day</span>
                    }
                    else
                    {
                        <span>
                            @Model.StartDate.ToString("MMM, d")
                        </span>
                        <span> - </span>
                        <span> @Model.Enddate.ToString("MMM, d") </span>
                    }
                }
            }
        </b>
    </div>


    <div class="clear"></div>
    <div class="six columns">
           The Seminar <br />
            <b>Location</b>
            <hr class="hr" />
            <span>@Html.Raw(Model.Address1)</span><br>
            @if (!string.IsNullOrEmpty(Model.Address2))
            {
                <span> @Html.Raw(Model.Address2)</span>
            }
            @if (!string.IsNullOrEmpty(Model.City))
            {
                <br />
                <span> @Html.Raw(Model.City),</span>
            }
            @if (!string.IsNullOrEmpty(Model.StateProvince))
            {
                <span> @Html.Raw(Model.StateProvince)</span>
            }
            @if (!string.IsNullOrEmpty(Model.ZipPostalCode))
            {
                <span> @Html.Raw(Model.ZipPostalCode)</span>
            }
            @if (!string.IsNullOrEmpty(Model.Country))
            {
                <br />
                <span> @Html.Raw(Model.Country)</span>
                }
          
            <br />
        </div>

        <div class="clear"></div>
        <div class="six columns">
            Payment <br />
            <b>Instructions</b>
            <hr class="hr" />
            <span>Early bird registion fee is N85,000. The fee for registrations after the early bird registion period is N100,000.00.<br /> All fees include all workshop materials. </span><br />
            <span> make payments to : <b>GTB</b> bank AC#: <b>0171482631<b></b></span>

            <!--<span>PayPal and all major credit cards are accepted. </span><br /><br />-->
            <span></span>
        </div>
        <div class="clear"></div>
        <div class="six columns">
            Special Lodging Rate <br />
            <b>Information</b>
            <hr class="hr" />
            <span>Princess Luxury Hotel</span>
            <span>Phone :</span>
            <span>09032499226</span><br />
            <!-- <span>Fax :</span>
             <span>@Html.Raw(Model.Fax)</span><br />-->
            <span>Email :</span>
            <span>info@princessluxuryhotels.com</span><br />
            <span>Lodging Rate : 30% off</span><br>
        </div>

        <div class="clear"></div>

        <div class="six columns">
            @if (Model.StartDate != null && Model.StartDate != default(DateTime))
            {
                <a href='@Url.Action("RegisterSeminar", "Workshop", new { id = Model.seminar_id })' class='button medium green'>Register Now</a>
            }
        </div>

</div>
