@using System.Collections.Generic;
@using StatisticalSolutions.Models;
@using StatisticalSolutions.ViewModels;

@{
    ViewBag.Title = "WorkShops";
}

<meta http-equiv="Content-Type" content="text/html;charset=utf-8" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />

<div class="container focus">
    <h4>Currently Available WorkShops</h4>
</div>

<div class="clear"></div>

<div class='container focus'>
    @{List<seminar> seminars = ViewBag.Seminars as List<seminar>;}
    @if (seminars.Count > 0)
    {
        <div class="four columns">

            @foreach (seminar sem in seminars)
            {
                <ul>
                    <li>
                        @Html.ActionLink(sem.TitleHtml, "Workshop", new { id = sem.seminar_id })
                        <hr />
                    </li>
                </ul>
            }
        </div>
 
            seminar seminar = ViewBag.Seminar as seminar;
            if (seminar != null)
        {
        <div class='nine columns'>
            <div class='nine columns'>
                <div class="font-bold" style="text-align:center;">
                    <strong>@Html.Raw(seminar.TitleHtml)</strong>
                </div>
                <div style="text-align:center;">
                    @{  string consultant = ViewBag.Consultant as string;}
                    <span> Taught by @consultant</span>
                </div>

                <br />
                @Html.Raw(seminar.EventDetailsHtml)
            </div>

        </div>

        <div class='container six columns'>
            @Html.Partial("_SeminarInfoPartial", seminar)
        </div>
        }
        else
        {
        <div class='nine columns'>

            <p> Here are all of our currently scheduled seminars for spring 2015. Just click on the course titles for detailed information and registration. All seminars meet for two full days, unless otherwise noted. Please check back periodically for updates.</p>
            <br />

            @{List<SeminarInstructorModel> sem_ins = ViewBag.Seminar_Instructors as List<SeminarInstructorModel>;}
            @foreach (SeminarInstructorModel sems in sem_ins)
            {
                @Html.Partial("_SeminarListPartial", sems)
            }
        </div>

        <div class='container six columns'>
            Featured <br /><b>Consultants</b>
            <hr class="hr" />
            @{List<instructor> instructors = ViewBag.Instructors as List<instructor>;}
            @foreach (instructor ins in instructors)
            {
                @Html.Partial("_InstructorPartial", ins)
            }
        </div>
        }
    }
</div>