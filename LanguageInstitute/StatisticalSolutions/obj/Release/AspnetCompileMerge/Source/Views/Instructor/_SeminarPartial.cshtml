@model StatisticalSolutions.ViewModels.SeminarInstructorModel
<ul>
    <li >
        <a class="light-orange font-bold" href='@Url.Action("Workshop", "Workshop", new { id = Model.seminar.seminar_id })'>@Model.seminar.TitleHtml</a>
    </li>
    <li>
        <a class="light-orange" href='@Url.Action("Consultant", "Instructor", new { id = Model.Instructor.instructor_id })'>@Model.Instructor.Name</a>  
    </li>
    <li>


        @if (Model.seminar.StartDate == Model.seminar.Enddate)
        {
            @Model.seminar.StartDate.ToString("MMM, d")
        }
        else
        {
            if (Model.seminar.StartDate.Month == Model.seminar.Enddate.Month)
            {
                <span>
                    @Model.seminar.StartDate.ToString("MMM, d")
                </span>
                <span> - </span>
                <span>  @Model.seminar.Enddate.Day</span>
            }         
            else
            {
                <span>
                    @Model.seminar.StartDate.ToString("MMM, d")
                </span>
                <span> - </span>
                <span> @Model.seminar.Enddate.ToString("MMM, d") </span>
            }


        }
        @if (!string.IsNullOrEmpty(Model.seminar.City))
        {
            <span>, </span>  <span>

                @Model.seminar.City
            </span>
        }
        <div class="clear"></div>

    </li>

</ul>

