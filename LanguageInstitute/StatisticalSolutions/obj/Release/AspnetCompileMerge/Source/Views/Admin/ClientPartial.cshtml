@model StatisticalSolutions.Models.client

    <tr>
        <td>
            @Html.DisplayFor(model => model.Name)
            @Html.HiddenFor(model => model.client_id)

        </td>
        <td>
            @Html.DisplayFor(model => model.Email)

        </td>
        <td>
            @Html.DisplayFor(model=> model.Phone)
        </td> 
        <td>
            @Html.ActionLink("Edit", "EditClient", new { id = Model.client_id }) | 
            @Html.ActionLink("Delete", "DeleteClient", new { id = Model.client_id })
            
        </td>
    </tr>
