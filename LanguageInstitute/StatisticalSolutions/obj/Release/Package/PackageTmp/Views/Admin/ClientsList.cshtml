@using System.Collections.Generic;
@using StatisticalSolutions.Models;
@model List<client>
@{
    ViewBag.Title = "ClientsList";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
}

<link href="~/Content/bootstrap.css" rel="stylesheet" />
<div class='container focus'>
    <div class="breadcrumb" id="divPageTitle_Add">
        <a tabindex="1" href="@Url.Action("Admin", "Account")">Dashboard</a>
        <span class="active"> - Company List</span>
    </div>


@if (!string.IsNullOrEmpty(ViewBag.InactiveClients))
{
    <div class='sixteen form'>

        <div class="checkbox ">
            @using (Html.BeginForm("InactiveClients", "Admin", FormMethod.Post, new { @style = "margin:0;margin-left:20px;" }))
            {
                <input type="checkbox" name="IsActive" value="false" onclick=" this.form.submit();" />
                <span>Inactive Companies</span>
            }
        </div>

    </div>
}


    <div class='sixteen form'>
        <section>

            <div class="content">
              @if (Model.Count != 0)
                {
                <table class="table table-bordered table-striped" style="width:100%">
                    <thead>
                        <tr>
                            <th style="width:40%;">Company</th>
                            <th style="width:30%;">Email</th>
                            <th style="width:20%;">Contact</th>
                            
                            <th style="width:10%;"></th>
                        </tr>

                    </thead>
                    <tbody>
                        @foreach (client client in Model)
                        {
                            @Html.Partial("ClientPartial", client)
                        }

                    </tbody>
                </table>
                }
                else
                {
                <p>no companies records found</p>
                }

            </div>

        </section>
    </div>
</div>