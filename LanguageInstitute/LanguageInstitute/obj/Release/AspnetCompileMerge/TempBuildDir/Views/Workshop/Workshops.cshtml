@using System.Collections.Generic;
@using StatisticalSolutions.Models;
@model WorkshopInstructorViewModel

@{
    ViewBag.Title = "WorkShops";
}

<meta http-equiv="Content-Type" content="text/html;charset=utf-8" />
<link href="~/Content/bootstrap.css" rel="stylesheet" />
<div class="container nine columns text-center font-24">
    Currently Available WorkShops
</div>

<div class="clear"></div>
<div class='container focus'>
  @if (Model!=null)
  { 
      if (Model.Seminars!= null)
    {
        <div class="four columns">

            @foreach (seminar sem in Model.Seminars)
            {
                <ul>
                    <li>
                        @*@Html.ActionLink(sem.TitleHtml, "Workshop", new { id = sem.seminar_id })*@
                        <a href='#' onclick='bindPartialView("divWorkshop","Workshop","WorkshopDetails",@sem.seminar_id)'>@sem.TitleHtml</a>
                        <hr />
                    </li>
                </ul>
            }
        </div> 
         <div class="fifteen" id="divWorkshop">
             @if (Model.Seminar != null)
             {
             <div class='nine columns'>

                 <div class='nine columns'>
                     <div class="font-bold" style="text-align:center;">
                         <strong>@Html.Raw(Model.Seminar.TitleHtml)</strong>
                     </div>
                     <div style="text-align:center;">
                         @if (Model.Seminar.instructor != null)
                         {
                             <span> @Model.Seminar.instructor.Name</span>
                         }

                     </div>

                     <br />
                     @Html.Raw(Model.Seminar.EventDetailsHtml)
                 </div>

             </div>

             <div class='container six columns'>
                 @Html.Partial("_SeminarInfoPartial", Model.Seminar)
             </div>
             }
             else
             {
             <div class='nine columns'>


                 <p> Here are all of our currently scheduled seminars for the Summer and Fall of 2015. Just click on the course titles for detailed information and registration. All seminars meet for two full days, unless otherwise noted. Please check back periodically for updates.</p>
                 <br />


                 @foreach (seminar sems in Model.Seminars)
                 {
                     @Html.Partial("_SeminarListPartial", sems)
                 }
             </div>

             <div class='container six columns'>
                 Featured <br /><b>Consultants</b>
                 <hr class="hr" />

                 @foreach (instructor ins in Model.Instructors)
                 {
                     @Html.Partial("_InstructorPartial", ins)
                 }
             </div>
             }
         </div>  
         
    }
}
   
</div>