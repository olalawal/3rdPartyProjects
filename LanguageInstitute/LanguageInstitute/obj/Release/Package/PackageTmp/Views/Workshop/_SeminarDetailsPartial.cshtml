<div class="four columns">
    <div class="sidebar">
        <div class="sideborder"></div>
        <h5>Most Popular Posts</h5>
        <ul class="blogs">
            <li>

                Available dates : <b>
                    @if (Model.StartDate != null && Model.StartDate != default(DateTime))
                    {
                        if (Model.StartDate == Model.Enddate)
                        {
                            @Model.StartDate.ToString("MMM, d")
                        }
                        else
                        {
                            if (Model.StartDate.Month == Model.Enddate.Month)
                            {
                                <span>
                                    @Model.StartDate.ToString("MMM, d")
                                </span>
                                <span> - </span>
                                <span>  @Model.Enddate.Day</span>
                            }
                            else
                            {
                                <span>
                                    @Model.StartDate.ToString("MMM, d")
                                </span>
                                <span> - </span>
                                <span> @Model.Enddate.ToString("MMM, d") </span>
                            }
                        }
                    }
                </b>

                <div class="clear"></div>
            </li>

            <li>
                The Seminar <br />
                <b>Location</b>
                <hr class="hr" />
                <span>@Html.Raw(Model.Address1)</span><br>
                @if (!string.IsNullOrEmpty(Model.Address2))
                {
                    <span> @Html.Raw(Model.Address2)</span>
                }
                @if (!string.IsNullOrEmpty(Model.City))
                {
                    <br />
                    <span> @Html.Raw(Model.City),</span>
                }
                @if (!string.IsNullOrEmpty(Model.StateProvince))
                {
                    <span> @Html.Raw(Model.StateProvince)</span>
                }
                @if (!string.IsNullOrEmpty(Model.ZipPostalCode))
                {
                    <span> @Html.Raw(Model.ZipPostalCode)</span>
                }
                @if (!string.IsNullOrEmpty(Model.Country))
                {
                    <br />
                    <span> @Html.Raw(Model.Country)</span>
                }

                <br />
                <div class="clear"></div>
            </li>

            <li>
                <div class="border">
                    <img src="images/sidebar-beach.jpg" />
                    <a href="images/untouched/beachstorm.jpg" class="zoom prettyPhoto"></a>
                </div>
                <p>
                    <a href="#">Integer Sit Amet</a>
                    Cras ac nisl at si gravida...
                    <span>September 20, 2012</span>
                </p>
                <div class="clear"></div>
            </li>
        </ul>

        <h5>From the Portfolio</h5>
        Payment <br />
        <b>Instructions</b>
        <hr class="hr" />
        <span>Early bird registion fee is N85,000. The fee for registrations after the early bird registion period is N100,000.00.<br /> All fees include all workshop materials. </span><br />
        <span> make payments to : <b>GTB</b> bank AC#: <b>0171482631<b></b></span>

        <!--<span>PayPal and all major credit cards are accepted. </span><br /><br />-->
        <span></span>

        <div class="clear"></div>



    </div>
</div>

<div class="clear"></div>
<a class="button color" href="blog-post.html"><span>Register</span></a>

<div class="sixteen columns">
    <span class="hr lip-quote"></span>
    <blockquote class="standard bottom">
        "Making the simple complicated is commonplace; making the complicated simple, awesomely simple, that's creativity" <br />- Charles Mingus
    </blockquote>
</div>


<script type="text/javascript">
    $(document).ready(function () {
        $('.slidewrap2').carousel({
            slider: '.slider',
            slide: '.slide',
            slideHed: '.slidehed',
            nextSlide: '.next',
            prevSlide: '.prev',
            addPagination: false,
            addNav: false
        });
        $('.acc-active').click();
    });
    $(window).load(function () {
        $("a[class^='prettyPhoto']").prettyPhoto({ social_tools: '' });
    });
</script>
