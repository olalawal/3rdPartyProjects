@using LanguageInstitute.Models
@model List<seminar>
@{
    ViewBag.Title = "WorkshopList";
}
<link href="~/Content/bootstrap.css" rel="stylesheet" />

<div class='container focus'>
   
     <div class="breadcrumb" id="divPageTitle_Add">
        <a tabindex="1" href="@Url.Action("Admin", "Admin")">Dashboard</a>
        <span class="active"> - Workshop List</span>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.InactiveWorkshops))
    {
        <div class='sixteen form'>

            <div class="checkbox ">
                @using (Html.BeginForm("InactiveWorkshops", "Admin", FormMethod.Post, new { @style = "margin:0;margin-left:20px;" }))
                {
                    <input type="checkbox" name="IsActive" value="false" onclick=" this.form.submit();" />
                    <span>Inactive Workshops</span>
                }
            </div>

        </div>
    }
    <div class='sixteen form'>
        <section>

            <div class="content">
                @if (Model.Count != 0)
                {
                    <table class="table table-bordered table-striped" style="width:100%">
                        <thead>
                            <tr>
                                <th style="width:20%;">Title</th>
                                <th style="width:20%;">Instructor</th>
                                <th style="width:17%;">Start Date</th>
                                <th style="width:17%;">End Date</th>
                                <th style="width:8%;">Start Time</th>
                                <th style="width:8%;">End Time</th>
                                <th style="width:10%;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (seminar sem in Model)
                            {
                                @Html.Partial("WorkshopPartial", sem)
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p>no workshop records found</p>
                }

            </div>

        </section>
    </div>
    

</div>










