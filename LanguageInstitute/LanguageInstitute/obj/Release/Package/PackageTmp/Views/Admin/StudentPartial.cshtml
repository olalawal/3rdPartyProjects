@model StatisticalSolutions.Models.student

    <tr>
    <td>
        @Html.DisplayFor(model => model.LastName), @Html.DisplayFor(m => m.FirstName)             
    </td>                               
    <td>
        @Html.DisplayFor(model => model.Email)       
    </td>
    <td>
        @Html.DisplayFor(model => model.Phone)
    </td> 
    <td>
        @Html.ActionLink("Edit", "EditStudent", new { id = Model.student_id }) | 
        @Html.ActionLink("Delete", "DeleteStudent", new { id = Model.student_id })
            
    </td>
</tr>
