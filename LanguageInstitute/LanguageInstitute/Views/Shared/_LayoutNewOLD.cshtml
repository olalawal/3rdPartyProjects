                BulkMailSentSuccessfully:'@Html.GetErrorMessageBasedOnCode("BULK_MAILS_SENT_SUCCESSFULLY")'
        
            };

            function WaitUI() {
                var divWaitMessage = $('<div id="WaitMessage" style="display:none"><button class="spinner"><i class="fa fa-refresh fa-spin"></i>Please wait...</button></div>');
                $("body").append(divWaitMessage);
                var obj = {
                    message: $('#WaitMessage'), css: {
                        border: 'none',
                        backgroundColor: 'none',
                        top: ($(window).height() - 100) / 2 + 'px',
                        left: ($(window).width() - 100) / 2 + 'px',
                        width: '150px',
                        opacity: 1
                    }
                };
                $.blockUI(obj);
                return obj;
            }
            $.ajaxSetup({ cache: false });
            $(document).ajaxStop(function () {

                $.unblockUI();
            });


    function bindPartialView(container, controller, action, id) {

    
        var myURL = controller+'/'+action;
        var fullurl = baseSiteURL + myURL;
    
        $.ajax({
            url: fullurl,
            data: {'id': id },
            type: "POST",
            cache: false,
            //datatype: 'json',
            //contentType: 'application/json; charset=utf-8',
            success: function (data) {             
                $("#"+container).html(data);
            },
            error: function (xhr, ajaxOptions, thrownError) {
                Statistical_Alert.error({ title: thrownError, text: '' });
            }
        });


    }
</script>
     
