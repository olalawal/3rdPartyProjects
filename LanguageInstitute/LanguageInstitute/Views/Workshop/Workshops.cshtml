@using System.Collections.Generic;
@using LanguageInstitute.Models;
@model WorkshopInstructorViewModel

@{
    ViewBag.Title = "Classes";
    Layout = "~/Views/Shared/_LayoutNew.cshtml";
    HtmlHelper.ClientValidationEnabled = true;
}





<div class="body">
    <div class="body-round"></div>
    <div class="body-wrapper">
        <div class="side-shadows"></div>
        <div class="content">
            <div class="container callout standard">

                <div class="twelve columns">
                    <h4>Company’s Latest News</h4>
                    <p class="link-location">You are here: <a href="index.html">Home</a> / <a href="#">Some Link</a> / <a href="#">Current Page</a></p>
                </div>

                <div class="four columns button-wrap">
                    <div class="wrapper search">
                        <form action="">
                            <input type="text" class="search-box" name="" value="" placeholder='Search...' />
                            <input type="image" src="images/design/search-icon.png" class="searchbox-submit" value="" />
                        </form>
                    </div>
                </div>
            </div>
            <div class="callout-hr"></div>
            <div class="container">

                <div class="twelve columns">



                    @if (Model != null)
                    {
                        if (Model.Seminars != null && Model.Seminars.Count() > 0)
                        {

                            //TO DO load seminars here as list

                            foreach (seminar sem in Model.Seminars)
                            {

                                <div class="blog style-2">

                                    <div class="border">
                                        <img class="scale-with-grid" src="images/blog-arch.jpg" />
                                        <a class="link" href="blog-post.html"></a>
                                    </div>


                                    <div class="meta">
                                        <p>
                                            <span>Teacher:</span> <a href="#">
                                                @if (sem.instructor != null)
                                                {
                                                    <span> @sem.instructor.Name</span>
                                                }
                                            </a>
                                        </p>
                                        <p><span>Start date:</span> <a href="#">@sem.StartDate.ToString("MMM, d")</a></p>
                                        <p><span>Category:</span> <a href="#">WorkShop</a></p>
                                        <p><span><a href="#">5 spots avialable</a></span></p>
                                    </div>
                                    <div class="description">
                                        <h5><strong>@Html.Raw(sem.TitleHtml)</strong></h5>

                                        <b>@sem.Description  </b>
                                        <p>
                                            @sem.EventDetailsHtml

                                        </p>

                                        @*<a class="link" href="blog-post.html" class="button color"><span>More</span></a>*@
                                        <a href='#' class="button" onclick='bindPartialView("divWorkshop","Workshop","WorkshopDetails",@sem.seminar_id)'>more</a>
                                    </div>
                                    <div class="clear"></div>
                                    <div class="foot"></div>

                                </div><!-- Blog Ends -->


                            }


                        }
                        else
                        {
                            <div class="blog style-2">

                                <div class="border">
                                    <img class="scale-with-grid" src="images/blog-arch.jpg" />
                                    <a class="link" href="blog-post.html"></a>
                                </div>


                                <div class="meta">
                                    <p><span>Teacher:</span> <a href="#">TBD</a></p>
                                    <p><span>Posted:</span> <a href="#">August 29</a></p>
                                    <p><span>Category:</span> <a href="#">Language</a></p>
                                    <p><span><a href="#">10 Comments</a></span></p>
                                </div>
                                <div class="description">
                                    <h5>Youruba Culture Seminar</h5>
                                    <p>
                                        Heritage language learners are learners who already have some familiarity with the language through exposure at home or
                                        through previous interactions with native speakers of the language. The focus here will be on developing proficiency in
                                        reading Yoruba literary texts and newspapers, writing about current topical issues, and developing communicative competency in
                                        cultural and social contexts beyond the basic level. Emphasis will be on turning them into competent speakers of the language by building
                                        on what they already know.  Heritage class 2 continues with building proficiency in speaking, writing and reading through exposure to more advanced readings and writing.

                                    </p>

                                    <a class="link" href="blog-post.html" class="button color"><span>More</span></a>
                                </div>
                                <div class="clear"></div>
                                <div class="foot"></div>

                            </div><!-- Blog Ends -->

                        }

                    }

