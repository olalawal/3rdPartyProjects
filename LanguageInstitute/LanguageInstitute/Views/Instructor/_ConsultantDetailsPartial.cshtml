@model LanguageInstitute.Models.instructor
<div class='nine columns'>
    <div class="nine">
        @{string path = "http://LanguageInstitute.azurewebsites.net/" + Model.ImagePath;}
        <img src=@path height="120" width="120" class="img-circle" />
        &nbsp; &nbsp; &nbsp;
        <strong>
            @Html.Raw(Model.Name)
        </strong>
    </div>
    <div class="nine">

        <br />
        @if(!string.IsNullOrEmpty(Model.Description))
        {
            @Html.Raw(Model.Description.Trim())  
        }
      
    </div>
    <hr />
    <br />
    @Html.Raw(Model.DetailsHtml)
</div>