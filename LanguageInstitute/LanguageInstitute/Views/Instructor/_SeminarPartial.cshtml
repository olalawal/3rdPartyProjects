@modelLanguageInstitute.Models.seminar
<ul>
    <li >
        <a class="light-orange font-bold" href='@Url.Action("Workshop", "Workshop", new { id = Model.seminar_id })'>@Model.TitleHtml</a>
    </li>
    <li>
        @if (Model.instructor!=null)
        {
            <a class="light-orange" href='@Url.Action("Consultant", "Instructor", new { id = Model.instructor.instructor_id })'>@Model.instructor.Name</a>  
        }
        
    </li>
    <li>


        @if (Model.StartDate == Model.Enddate)
        {
            @Model.StartDate.ToString("MMM, d")
        }
        else
        {
            if (Model.StartDate.Month == Model.Enddate.Month)
            {
                <span>
                    @Model.StartDate.ToString("MMM, d")
                </span>
                <span> - </span>
                <span>  @Model.Enddate.Day</span>
            }         
            else
            {
                <span>
                    @Model.StartDate.ToString("MMM, d")
                </span>
                <span> - </span>
                <span> @Model.Enddate.ToString("MMM, d") </span>
            }


        }
        @if (!string.IsNullOrEmpty(Model.City))
        {
            <span>, </span>  <span>

                @Model.City
            </span>
        }
        <div class="clear"></div>

    </li>

</ul>

